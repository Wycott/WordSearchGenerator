<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System.Configuration.ConfigurationManager">
      <section name="WordSearchGen.Properties.Settings" type="System.Configuration.ClientSettingsSection, System.Configuration.ConfigurationManager" requirePermission="false" />
    </sectionGroup>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System.Configuration.ConfigurationManager">
      <section name="WordSearchGen.Properties.Settings" type="System.Configuration.ClientSettingsSection, System.Configuration.ConfigurationManager" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <userSettings>
    <WordSearchGen.Properties.Settings>
      <!-- The skill level selected when the app starts: Beginner, Intermediate or Advanced.
           The level chosen when the app is closed is saved to the user's user.config and overrides this. -->
      <setting name="SkillLevel" serializeAs="String">
        <value>Advanced</value>
      </setting>
    </WordSearchGen.Properties.Settings>
  </userSettings>
  <applicationSettings>
    <WordSearchGen.Properties.Settings>
      <!-- How long, in seconds, a word stays highlighted in the grid after its clue is clicked. -->
      <setting name="HighlightSeconds" serializeAs="String">
        <value>3</value>
      </setting>
      <!-- How long, in milliseconds, each half of a flash lasts (the word shown, then hidden). -->
      <setting name="FlashMilliseconds" serializeAs="String">
        <value>250</value>
      </setting>
    </WordSearchGen.Properties.Settings>
  </applicationSettings>
</configuration>
